PORT=5000
NODE_ENV=development

API_VERSION=v1

CORS_ORIGIN=['*']

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beaconboard

# AI Insights (optional — leave blank to disable the feature)
# Get a free API key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash-lite

# Set automatically by Render — no need to add this manually when deploying there
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
